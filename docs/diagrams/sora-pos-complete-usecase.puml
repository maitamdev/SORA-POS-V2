@startuml Sora_POS_Complete_Use_Case
title SORA POS V2 — BIỂU ĐỒ USE CASE TỔNG THỂ
left to right direction

skinparam backgroundColor #FFFDF7
skinparam shadowing false
skinparam linetype polyline
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam ArrowColor #6F6F66
skinparam ActorBorderColor #45453E
skinparam ActorBackgroundColor #FFFDF0
skinparam ActorFontColor #28281F
skinparam UsecaseBorderColor #746A18
skinparam UsecaseBackgroundColor #FFF7B7
skinparam UsecaseFontColor #28281F
skinparam RectangleBorderColor #A5A58F
skinparam RectangleBackgroundColor #FFFDF7

actor "Nhân viên\nđã xác thực" as Employee
actor "Thu ngân\n(Cashier)" as Cashier
actor "Quản lý\n(Manager)" as Manager
actor "Quản trị viên\n(Admin)" as Admin
actor "Khách hàng" as Customer
actor "Sora Scanner\n(Mobile)" as Scanner
actor "PayOS /\nNgân hàng" as PayOS
actor "Groq AI" as Groq
actor "Email SMTP" as SMTP
actor "Telegram Bot" as Telegram
actor "Supabase\nRealtime" as Realtime

Manager <|-- Admin

rectangle "HỆ THỐNG SORA POS V2" {
  usecase "Đăng nhập" as Login
  usecase "Đăng xuất" as Logout
  usecase "Xem thông tin\ntài khoản" as Profile
  usecase "Tra cứu sản phẩm" as ViewProducts
  usecase "Tìm kiếm / quét\nmã sản phẩm" as Scan
  usecase "Thực hiện bán hàng\n(POS)" as POS
  usecase "Quản lý giỏ hàng" as Cart
  usecase "Quản lý khách hàng" as Customers
  usecase "Tra cứu hóa đơn" as Orders
  usecase "In / tải hóa đơn" as Invoice
  usecase "Gửi hóa đơn qua email" as EmailInvoice

  usecase "Áp dụng khuyến mãi\ntự động / mã giảm giá" as ApplyPromo
  usecase "Thanh toán đơn hàng" as Checkout
  usecase "Thanh toán tiền mặt / thẻ" as CashCard
  usecase "Thanh toán QR\nPayOS / VietQR" as QRPayment
  usecase "Tạo đơn & cập nhật\ntồn kho nguyên tử" as CreateOrder
  usecase "Xem ca của tôi" as MyShift
  usecase "Check-in / đóng\nca cá nhân" as CheckinClose
  usecase "Ghi nhận thu / chi\nkét tiền" as CashDrawer
  usecase "Xem tồn kho" as Inventory
  usecase "Cảnh báo tồn thấp\n& sắp hết hạn" as Alerts

  usecase "Quản lý sản phẩm\n& nhập hàng loạt" as Products
  usecase "Quản lý danh mục" as Categories
  usecase "Quản lý khuyến mãi" as Promotions
  usecase "Quản lý nhà cung cấp" as Suppliers
  usecase "Nhập / điều chỉnh tồn" as AdjustStock
  usecase "Tạo & xem phiếu nhập" as Receipts
  usecase "Cập nhật thanh toán\nphiếu nhập" as ReceiptPayment
  usecase "Lập, theo dõi,\nđóng / hủy ca" as ManageShift
  usecase "Xem nhân viên &\nbáo cáo hiệu suất" as StaffReport
  usecase "Xem Dashboard" as Dashboard
  usecase "Báo cáo doanh thu, lợi nhuận,\ntop sản phẩm" as Reports

  usecase "Tạo / sửa / vô hiệu hóa\ntài khoản nhân viên" as StaffAdmin
  usecase "Cấu hình vận hành,\nhóa đơn, kho & ngân hàng" as Settings
  usecase "Tra cứu nhật ký kiểm toán" as Audit
  usecase "Hủy / xóa hóa đơn\n& hoàn kho" as ManageOrders
  usecase "Xử lý cảnh báo tồn" as ResolveAlert
  usecase "AI nhận diện & làm giàu\ndữ liệu sản phẩm" as AIProduct
  usecase "Phân tích doanh thu\nbằng AI & xem lịch sử" as AIRevenue
  usecase "Khuyến nghị nhập hàng\nbằng AI" as AIRestock
  usecase "Duyệt trạng thái\nkhuyến nghị AI" as AIStatus
  usecase "Cảnh báo & tra cứu\nqua Telegram" as TelegramUC
  usecase "Ghép đôi Sora Scanner\n& đồng bộ Realtime" as PairScanner

  POS .> Scan : <<include>>
  POS .> Cart : <<include>>
  POS .> ApplyPromo : <<include>>
  POS .> Checkout : <<include>>
  Checkout .> CreateOrder : <<include>>
  CashCard .> Checkout : <<extend>>
  QRPayment .> Checkout : <<extend>>
  Invoice .> CreateOrder : <<extend>>
  EmailInvoice .> CreateOrder : <<extend>>
  Receipts .> AdjustStock : <<include>>
  ReceiptPayment .> Receipts : <<extend>>
  ManageOrders .> Orders : <<extend>>
  AIRevenue .> Reports : <<extend>>
  AIStatus .> AIRestock : <<extend>>
  PairScanner .> Scan : <<extend>>
}

Employee -- Login
Employee -- Logout
Employee -- Profile
Employee -- ViewProducts
Employee -- Scan
Employee -- POS
Employee -- Customers
Employee -- Orders
Employee -- Inventory
Employee -- Alerts

Cashier -- POS
Cashier -- Cart
Cashier -- Checkout
Cashier -- MyShift
Cashier -- CheckinClose
Cashier -- CashDrawer
Cashier -- Invoice
Cashier -- EmailInvoice

Manager -- Products
Manager -- Categories
Manager -- Promotions
Manager -- Suppliers
Manager -- AdjustStock
Manager -- Receipts
Manager -- ReceiptPayment
Manager -- ManageShift
Manager -- StaffReport
Manager -- Dashboard
Manager -- Reports
Manager -- ManageOrders
Manager -- ResolveAlert
Manager -- AIProduct
Manager -- AIRevenue
Manager -- AIRestock
Manager -- AIStatus
Manager -- Audit

Admin -- StaffAdmin
Admin -- Settings
Admin -- Audit
Admin -- ManageOrders
Admin -- ResolveAlert

Customer -- Checkout
Customer -- CashCard
Customer -- QRPayment
Customer -- Invoice
Customer -- EmailInvoice
Scanner -- Scan
Scanner -- PairScanner
PayOS -- QRPayment
Groq -- AIProduct
Groq -- AIRevenue
Groq -- AIRestock
SMTP -- EmailInvoice
Telegram -- TelegramUC
Realtime -- PairScanner
Realtime -- Alerts

@enduml
